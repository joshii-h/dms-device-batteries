{
    "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
    "id": "deviceBatteries",
    "name": "Device Batteries",
    "description": "Battery levels of your phone, Bluetooth devices, Razer mice and USB headsets in one bar widget, with a low-battery warning",
    "version": "1.3.0",
    "author": "joshii-h",
    "icon": "battery_full",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "monitoring"
    ],
    "components": {
        "daemon": "./DeviceBatteriesDaemon.qml",
        "widget": "./DeviceBatteries.qml"
    },
    "settings": "./DeviceBatteriesSettings.qml",
    "dependencies": [
        "python3",
        "upower"
    ],
    "requires_dms": ">=2.0.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ],
    "license": "MIT"
}
